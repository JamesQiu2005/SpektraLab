#version 450

// RFC-028 Cineon digital intermediate: the positive as log10 densities per
// film channel, optional blue-sector compensation in Oklab, then Cineon encode.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } input_data;
layout(set = 0, binding = 1, std430) readonly buffer Parameters { float value[]; } parameters;
layout(set = 0, binding = 2, std430) readonly buffer Count { uint value[]; } count_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float value[]; } output_data;

uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) +
           gl_GlobalInvocationID.x;
}

void main() {
    uint i = spk_global_index();
    if (i >= count_data.value[0]) return;
    vec3 pos = vec3(
        pow(10.0, input_data.value[3u * i] + parameters.value[9]),
        pow(10.0, input_data.value[3u * i + 1u] + parameters.value[10]),
        pow(10.0, input_data.value[3u * i + 2u] + parameters.value[11]));
    pos -= vec3(parameters.value[40]) * vec3(
        pow(10.0, parameters.value[9]),
        pow(10.0, parameters.value[10]),
        pow(10.0, parameters.value[11]));
    vec3 linear = vec3(
        pos.x * parameters.value[0] + pos.y * parameters.value[3] + pos.z * parameters.value[6],
        pos.x * parameters.value[1] + pos.y * parameters.value[4] + pos.z * parameters.value[7],
        pos.x * parameters.value[2] + pos.y * parameters.value[5] + pos.z * parameters.value[8]);
    if (parameters.value[30] != 0.0) {
        vec3 lms = vec3(
            parameters.value[12] * linear.x + parameters.value[13] * linear.y +
                parameters.value[14] * linear.z,
            parameters.value[15] * linear.x + parameters.value[16] * linear.y +
                parameters.value[17] * linear.z,
            parameters.value[18] * linear.x + parameters.value[19] * linear.y +
                parameters.value[20] * linear.z);
        lms = pow(max(lms, vec3(0.0)), vec3(1.0 / 3.0));
        float L = 0.2104542553 * lms.x + 0.7936177850 * lms.y - 0.0040720468 * lms.z;
        float a = 1.9779984951 * lms.x - 2.4285922050 * lms.y + 0.4505937099 * lms.z;
        float b = 0.0259040371 * lms.x + 0.7827717662 * lms.y - 0.8086757660 * lms.z;
        float chroma = sqrt(a * a + b * b);
        float hue = atan(b, a) * 57.29577951308232;
        float delta = mod(hue - parameters.value[33] + 540.0, 360.0) - 180.0;
        float window = abs(delta) < parameters.value[34]
            ? 0.5 * (1.0 + cos(3.14159265358979 * delta / parameters.value[34])) : 0.0;
        float fade = clamp((chroma - parameters.value[35]) /
                           (parameters.value[36] - parameters.value[35]), 0.0, 1.0);
        window *= fade * fade * (3.0 - 2.0 * fade);
        if (window > 0.0) {
            float adjusted_hue = (hue + window * parameters.value[31]) * 0.017453292519943295;
            float adjusted_chroma = chroma * (1.0 + window * (parameters.value[32] - 1.0));
            a = adjusted_chroma * cos(adjusted_hue);
            b = adjusted_chroma * sin(adjusted_hue);
            vec3 rotated = vec3(
                L + 0.3963377774 * a + 0.2158037573 * b,
                L - 0.1055613458 * a - 0.0638541728 * b,
                L - 0.0894841775 * a - 1.2914855480 * b);
            lms = rotated * rotated * rotated;
            linear = vec3(
                parameters.value[21] * lms.x + parameters.value[22] * lms.y +
                    parameters.value[23] * lms.z,
                parameters.value[24] * lms.x + parameters.value[25] * lms.y +
                    parameters.value[26] * lms.z,
                parameters.value[27] * lms.x + parameters.value[28] * lms.y +
                    parameters.value[29] * lms.z);
        }
    }
    vec3 code = (parameters.value[37] + parameters.value[38] *
        log2(max(linear, vec3(0.0)) * (1.0 - parameters.value[41]) +
             parameters.value[41]) * 0.3010299956639812) /
        parameters.value[39];
    code = clamp(code, 0.0, 1.0);
    output_data.value[3u * i] = code.x;
    output_data.value[3u * i + 1u] = code.y;
    output_data.value[3u * i + 2u] = code.z;
}
