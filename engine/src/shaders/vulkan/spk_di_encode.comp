#version 450
// Exact parameter layout and order from nodes.metal spk_di_encode.
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer Input { float value[]; } input_data;
layout(set=0,binding=1,std430) readonly buffer Params { float value[]; } params;
layout(set=0,binding=2,std430) readonly buffer Meta { uint value[]; } meta;
layout(set=0,binding=3,std430) writeonly buffer Output { float value[]; } output_data;
uint spk_global_index() { return gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x)+gl_GlobalInvocationID.x; }
vec3 log10v(vec3 x) { return log(x)/log(10.0); }
void main() {
    uint i = spk_global_index();
    if (i >= meta.value[0]) return;
    precise vec3 pos = vec3(pow(10.0, input_data.value[3u * i] + params.value[9]),
                        pow(10.0, input_data.value[3u * i + 1u] + params.value[10]),
                        pow(10.0, input_data.value[3u * i + 2u] + params.value[11]));
    // The base is black: the same floor on every channel, scaled with the
    // live gain so brightness and the filters never lift it.
    pos -= vec3(params.value[40]) * vec3(pow(10.0, params.value[9]), pow(10.0, params.value[10]), pow(10.0, params.value[11]));
    precise vec3 lin = vec3(pos.x * params.value[0] + pos.y * params.value[3] + pos.z * params.value[6],
                        pos.x * params.value[1] + pos.y * params.value[4] + pos.z * params.value[7],
                        pos.x * params.value[2] + pos.y * params.value[5] + pos.z * params.value[8]);
    if (params.value[30] != 0.0) {
        // Oklab (Ottosson 2020); the window sits on the output hue and fades
        // out below a chroma floor, so greys and every other hue are exact.
        precise vec3 lms = vec3(params.value[12] * lin.x + params.value[13] * lin.y + params.value[14] * lin.z,
                            params.value[15] * lin.x + params.value[16] * lin.y + params.value[17] * lin.z,
                            params.value[18] * lin.x + params.value[19] * lin.y + params.value[20] * lin.z);
        lms = pow(max(lms, vec3(0.0)), vec3(1.0 / 3.0));
        precise float L = 0.2104542553 * lms.x + 0.7936177850 * lms.y - 0.0040720468 * lms.z;
        precise float a = 1.9779984951 * lms.x - 2.4285922050 * lms.y + 0.4505937099 * lms.z;
        precise float b = 0.0259040371 * lms.x + 0.7827717662 * lms.y - 0.8086757660 * lms.z;
        precise float C = sqrt(a * a + b * b);
        precise float h = atan(b, a) * 57.29577951308232;
        precise float d = mod(h - params.value[33] + 540.0, 360.0) - 180.0;
        precise float w = abs(d) < params.value[34] ? 0.5 * (1.0 + cos(3.14159265358979 * d / params.value[34])) : 0.0;
        precise float g = clamp((C - params.value[35]) / (params.value[36] - params.value[35]), 0.0, 1.0);
        w *= g * g * (3.0 - 2.0 * g);
        if (w > 0.0) {
            precise float h2 = (h + w * params.value[31]) * 0.017453292519943295;
            precise float C2 = C * (1.0 + w * (params.value[32] - 1.0));
            a = C2 * cos(h2);
            b = C2 * sin(h2);
            precise vec3 l_ = vec3(L + 0.3963377774 * a + 0.2158037573 * b,
                               L - 0.1055613458 * a - 0.0638541728 * b,
                               L - 0.0894841775 * a - 1.2914855480 * b);
            lms = l_ * l_ * l_;
            lin = vec3(params.value[21] * lms.x + params.value[22] * lms.y + params.value[23] * lms.z,
                         params.value[24] * lms.x + params.value[25] * lms.y + params.value[26] * lms.z,
                         params.value[27] * lms.x + params.value[28] * lms.y + params.value[29] * lms.z);
        }
    }
    // Kodak's Cineon encode with the black offset (`log_encoding_Cineon`).
    precise vec3 code = (params.value[37] + params.value[38] * log10v(max(lin, vec3(0.0)) * (1.0 - params.value[41]) + params.value[41])) / params.value[39];
    code = clamp(code, 0.0, 1.0);
    output_data.value[3u * i] = code.x; output_data.value[3u * i + 1u] = code.y; output_data.value[3u * i + 2u] = code.z;
}
