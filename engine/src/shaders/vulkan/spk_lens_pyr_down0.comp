#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer Image { float value[]; } image_data;
layout(set=0,binding=1,std430) readonly buffer Boost { float value[]; } boost;
layout(set=0,binding=2,std430) readonly buffer Meta { uint value[]; } meta;
layout(set=0,binding=3,std430) writeonly buffer Output { float16_t value[]; } out_data;
const float kB6[6] = float[6](1.0/32.0,5.0/32.0,10.0/32.0,10.0/32.0,5.0/32.0,1.0/32.0);
uint index() { return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x; }
vec3 ld3(uint s) { return vec3(image_data.value[3u*s],image_data.value[3u*s+1u],image_data.value[3u*s+2u]); }
vec3 source3(vec3 v) {
    if (boost.value[0] == 0.0) return v;
    vec3 o;
    for (uint c=0u;c<3u;++c) {
        float x=v[c];
        if (x<=boost.value[1]) o[c]=x;
        else { float dx=(x-boost.value[1])*boost.value[2]; o[c]=x+boost.value[4]*(exp(boost.value[3]*dx)-boost.value[3]*dx-1.0); }
    }
    return o;
}
void main() {
    uint i=index(), hin=meta.value[0], win=meta.value[1], hout=meta.value[2], wout=meta.value[3];
    if (i>=hout*wout) return;
    uint r=i/wout,j=i%wout; int fy=2*int(r)-2,fx=2*int(j)-2;
    vec3 s=vec3(0.0);
    for (int a=0;a<6;++a) {
        uint row=uint(clamp(fy+a,0,int(hin)-1))*win; vec3 acc=vec3(0.0);
        for (int b=0;b<6;++b) { uint xx=uint(clamp(fx+b,0,int(win)-1)); acc+=kB6[b]*source3(ld3(row+xx)); }
        s+=kB6[a]*acc;
    }
    out_data.value[3u*i]=float16_t(s.x); out_data.value[3u*i+1u]=float16_t(s.y); out_data.value[3u*i+2u]=float16_t(s.z);
}
