#version 450

// minilab.metal's `spk_minilab`: a catalogued film/paper pair (resources/minilab/README.md) printed
// through its qualified table instead of the optical print. Three steps in registers, each written
// as the Vulkan kernel that already does it alone and is validated against Metal:
//   1. the negative read in the minilab's printing density -- spk_spectral_epilogue (log mode);
//   2. the film's recovered log-positive -- spk_curves' interpolation (Metal interp_channel);
//   3. the table, positive -> paper CMY density -- spk_lut3d_trilinear (precise, Metal clamp).
// Bindings in the Metal kernel's buffer order: cmy, chd, base, ixs, ep (gain 3, offset 3),
// meta {pixels, wavelengths, curve K, table side}, xa, inv, y, lut, lo, inv_span, out.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Cmy { float value[]; } cmy;
layout(set = 0, binding = 1, std430) readonly buffer Chd { float value[]; } chd;
layout(set = 0, binding = 2, std430) readonly buffer Base { float value[]; } base_data;
layout(set = 0, binding = 3, std430) readonly buffer Ixs { float value[]; } ixs;
layout(set = 0, binding = 4, std430) readonly buffer Epilogue { float value[]; } ep;
layout(set = 0, binding = 5, std430) readonly buffer Meta { uint value[]; } meta;
layout(set = 0, binding = 6, std430) readonly buffer XAxis { float value[]; } x_axis;
layout(set = 0, binding = 7, std430) readonly buffer InverseSteps { float value[]; } inverse_steps;
layout(set = 0, binding = 8, std430) readonly buffer YAxis { float value[]; } y_axis;
layout(set = 0, binding = 9, std430) readonly buffer Lut { float value[]; } lut_data;
layout(set = 0, binding = 10, std430) readonly buffer Lower { float value[]; } lower;
layout(set = 0, binding = 11, std430) readonly buffer InverseSpan { float value[]; } inverse_span;
layout(set = 0, binding = 12, std430) writeonly buffer Output { float value[]; } output_data;

// vulkan_gpu.cpp folds a dispatch past maxComputeWorkGroupCount[0] (65535 on
// lavapipe and Intel) into rows of workgroups; this is the 1D index it means.
uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

// spk_curves.comp `interpolate` (Metal `interp_channel`).
float interpolate(uint count, uint channel, float value) {
    float x0 = x_axis.value[channel];
    float x_last = x_axis.value[(count - 1u) * 3u + channel];
    if (value <= x0) return y_axis.value[channel];
    if (value >= x_last) return y_axis.value[(count - 1u) * 3u + channel];
    uint lo = 0u, hi = count;
    while (lo < hi) {
        uint mid = lo + ((hi - lo) >> 1u);
        if (x_axis.value[mid * 3u + channel] <= value) lo = mid + 1u;
        else hi = mid;
    }
    uint low = lo - 1u;
    float fraction = (value - x_axis.value[low * 3u + channel]) * inverse_steps.value[low * 3u + channel];
    float y0 = y_axis.value[low * 3u + channel];
    float y1 = y_axis.value[(low + 1u) * 3u + channel];
    return y0 + fraction * (y1 - y0);
}

// Metal's max(x, 0) is fmax: a NaN gives 0. GLSL's max with a NaN is undefined, and a NaN reaching
// `interpolate` would search to index -1 and read outside the curve; spell Metal's answer out.
float metal_fmax0(float x) {
    return (isnan(x) || x < 0.0) ? 0.0 : x;
}

// spk_lut3d_trilinear.comp: Metal's precise clamp, NaN to the lower bound.
float metal_clamp01(float x) {
    if (isnan(x) || x < 0.0) return 0.0;
    if (x > 1.0) return 1.0;
    return x;
}

void main() {
    uint gid = spk_global_index();
    if (gid >= meta.value[0]) return;
    uint wavelengths = meta.value[1], K = meta.value[2], size = meta.value[3];

    // 1. spk_spectral_epilogue, log mode
    float d0 = cmy.value[3u * gid], d1 = cmy.value[3u * gid + 1u], d2 = cmy.value[3u * gid + 2u];
    vec3 accumulated = vec3(0.0);
    for (uint l = 0u; l < wavelengths; ++l) {
        float density = d0 * chd.value[3u * l] + d1 * chd.value[3u * l + 1u] + d2 * chd.value[3u * l + 2u]
                      + base_data.value[l];
        float transmission = exp2(-density * 3.321928094887362);
        accumulated.x += transmission * ixs.value[3u * l];
        accumulated.y += transmission * ixs.value[3u * l + 1u];
        accumulated.z += transmission * ixs.value[3u * l + 2u];
    }
    float positive[3];
    for (uint c = 0u; c < 3u; ++c) {
        float v = metal_fmax0(accumulated[c] * ep.value[c] + ep.value[3u + c]) + 1e-10;
        v = log(v) * 0.4342944819032518;
        // 2. the film's recovered positive
        positive[c] = interpolate(K, c, v);
    }

    // 3. spk_lut3d_trilinear
    precise float scale = float(size - 1u);
    precise float c0 = (positive[0] - lower.value[0]) * inverse_span.value[0];
    precise float c1 = (positive[1] - lower.value[1]) * inverse_span.value[1];
    precise float c2 = (positive[2] - lower.value[2]) * inverse_span.value[2];
    c0 = metal_clamp01(c0) * scale;
    c1 = metal_clamp01(c1) * scale;
    c2 = metal_clamp01(c2) * scale;
    uint i0 = uint(floor(c0)), j0 = uint(floor(c1)), k0 = uint(floor(c2));
    uint i1 = min(i0 + 1u, size - 1u);
    uint j1 = min(j0 + 1u, size - 1u);
    uint k1 = min(k0 + 1u, size - 1u);
    precise float fx = c0 - float(i0), fy = c1 - float(j0), fz = c2 - float(k0);
    uint b00 = (i0 * size + j0) * size * 3u;
    uint b01 = (i0 * size + j1) * size * 3u;
    uint b10 = (i1 * size + j0) * size * 3u;
    uint b11 = (i1 * size + j1) * size * 3u;
    uint k0_offset = k0 * 3u, k1_offset = k1 * 3u;
    precise float w0 = 1.0 - fx, w1 = fx;
    precise float v0 = 1.0 - fy, v1 = fy;
    precise float u0 = 1.0 - fz, u1 = fz;
    for (uint channel = 0u; channel < 3u; ++channel) {
        precise float c00 = lut_data.value[b00 + k0_offset + channel] * u0 + lut_data.value[b00 + k1_offset + channel] * u1;
        precise float c01 = lut_data.value[b01 + k0_offset + channel] * u0 + lut_data.value[b01 + k1_offset + channel] * u1;
        precise float c10 = lut_data.value[b10 + k0_offset + channel] * u0 + lut_data.value[b10 + k1_offset + channel] * u1;
        precise float c11 = lut_data.value[b11 + k0_offset + channel] * u0 + lut_data.value[b11 + k1_offset + channel] * u1;
        precise float result = (c00 * v0 + c01 * v1) * w0 + (c10 * v0 + c11 * v1) * w1;
        output_data.value[3u * gid + channel] = result;
    }
}
