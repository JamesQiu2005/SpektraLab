#version 450

// Add the field in percent, using the print illuminant's XYZ channel values.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } input_data;
layout(set = 0, binding = 1, std430) readonly buffer Field { float value[]; } field_data;
layout(set = 0, binding = 2, std430) readonly buffer Illuminant { float value[]; } illuminant_data;
layout(set = 0, binding = 3, std430) readonly buffer Count { uint value[]; } count_data;
layout(set = 0, binding = 4, std430) writeonly buffer Output { float value[]; } output_data;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count_data.value[0]) return;
    uint channel = i % 3u;
    output_data.value[i] = input_data.value[i] +
        (field_data.value[i] / 100.0) * illuminant_data.value[channel];
}
