#version 450

// Hanatos spectral upsampling, front half. The matrix is row-major here,
// matching nodes.metal's spk_tc_b (not spk_matmul3's convention).
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } rgb_data;
layout(set = 0, binding = 1, std430) readonly buffer Matrix { float value[]; } matrix_data;
layout(set = 0, binding = 2, std430) readonly buffer Meta { uint value[]; } meta;
layout(set = 0, binding = 3, std430) writeonly buffer Coordinates { float value[]; } tc_data;
layout(set = 0, binding = 4, std430) writeonly buffer Brightness { float value[]; } brightness_data;

// vulkan_gpu.cpp folds a dispatch past maxComputeWorkGroupCount[0] (65535 on
// lavapipe and Intel) into rows of workgroups; this is the 1D index it means.
uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

void main() {
    uint i = spk_global_index();
    if (i >= meta.value[0]) return;
    float r = rgb_data.value[3 * i];
    float g = rgb_data.value[3 * i + 1];
    float blue = rgb_data.value[3 * i + 2];
    float X = matrix_data.value[0] * r + matrix_data.value[1] * g + matrix_data.value[2] * blue;
    float Y = matrix_data.value[3] * r + matrix_data.value[4] * g + matrix_data.value[5] * blue;
    float Z = matrix_data.value[6] * r + matrix_data.value[7] * g + matrix_data.value[8] * blue;
    float brightness = X + Y + Z;
    float denom = brightness > 1e-10 ? brightness : 1e-10;
    float x = X / denom;
    float y = Y / denom;
    float one_minus_x = 1.0 - x;
    float ty = y / (one_minus_x > 1e-10 ? one_minus_x : 1e-10);
    float tx = one_minus_x * one_minus_x;
    tc_data.value[2 * i] = clamp(tx, 0.0, 1.0);
    tc_data.value[2 * i + 1] = clamp(ty, 0.0, 1.0);
    brightness_data.value[i] = isnan(brightness) ? 0.0 : brightness;
}
