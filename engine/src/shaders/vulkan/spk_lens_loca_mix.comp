#version 450
#extension GL_GOOGLE_include_directive : require
// lens.metal spk_lens_loca_mix: out = A - M + B, B = G * M, M recomputed from A.
// p: {soft_r, soft_g, soft_b, gate, mid}; meta: {n}
#include "spk_lens.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) readonly buffer P { float p[]; };
layout(std430, binding = 3) readonly buffer Meta { uint meta[]; };
layout(std430, binding = 4) writeonly buffer Out { float dst[]; };

float loca_share(vec3 v) {
    float y = 0.25 * v.x + 0.5 * v.y + 0.25 * v.z;
    return (1.0 - p[3]) + p[3] * smoothstep(p[4], 4.0 * p[4], y);
}

void main() {
    uint i = spk_global_index();
    if (i >= meta[0]) return;
    vec3 va = SPK_LD3(a, i), vb = SPK_LD3(b, i);
    vec3 m = vec3(p[0], p[1], p[2]) * loca_share(va) * va;
    vec3 o = va - m + vb;
    SPK_ST3(dst, i, o);
}
