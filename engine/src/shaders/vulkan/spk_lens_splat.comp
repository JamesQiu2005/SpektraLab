#version 450
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer Image { float value[]; } image_data;
layout(set=0,binding=1,std430) readonly buffer Meta { uint value[]; } meta;
layout(set=0,binding=2,std430) writeonly buffer Output { float value[]; } out_data;
uint index() { return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x; }
vec3 ld3(uint s) { return vec3(image_data.value[3u*s],image_data.value[3u*s+1u],image_data.value[3u*s+2u]); }
void main() {
    uint i=index(), H=meta.value[0], W=meta.value[1], row0=meta.value[2], PH=meta.value[3], LW=meta.value[4];
    uint I0=meta.value[5], nI=meta.value[6], f=meta.value[7], outI0=meta.value[8];
    if(i>=nI*LW)return;
    uint I=I0+i/LW, J=i%LW;
    float ff=float(f), c=0.5*float(f-1u), cy=float(f*I)+c, cx=float(f*J)+c;
    int y0=int(floor(cy-ff))+1, y1=int(ceil(cy+ff))-1;
    int x0=int(floor(cx-ff))+1, x1=int(ceil(cx+ff))-1;
    vec3 acc=vec3(0.0);
    for(int y=y0;y<=y1;++y) {
        float wy=max(0.0,1.0-abs(float(y)-cy)/ff);
        int yp=clamp(y,0,int(PH)-1);
        uint yy=uint(clamp(yp-int(row0),0,int(H)-1));
        vec3 row=vec3(0.0);
        for(int x=x0;x<=x1;++x) {
            float wx=max(0.0,1.0-abs(float(x)-cx)/ff);
            uint xx=uint(clamp(x,0,int(W)-1));
            row+=wx*ld3(yy*W+xx);
        }
        acc+=wy*row;
    }
    acc/=ff*ff;
    uint o=(I-outI0)*LW+J;
    out_data.value[3u*o]=acc.x; out_data.value[3u*o+1u]=acc.y; out_data.value[3u*o+2u]=acc.z;
}
