#version 450
#extension GL_GOOGLE_include_directive : require
// lens.metal spk_lens_rows_put: dst row (dst_row + r) = src row (src_row + r).
// meta: {W, src_row, dst_row, n_floats}
#include "spk_lens.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Src { float src[]; };
layout(std430, binding = 1) readonly buffer Meta { uint meta[]; };
layout(std430, binding = 2) writeonly buffer Dst { float dst[]; };

void main() {
    uint i = spk_global_index();
    if (i >= meta[3]) return;
    dst[meta[2] * meta[0] * 3u + i] = src[meta[1] * meta[0] * 3u + i];
}
