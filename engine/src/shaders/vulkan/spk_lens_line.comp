#version 450
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer Level0 { float value[]; } L0;
layout(set=0,binding=1,std430) readonly buffer Level1 { float value[]; } L1;
layout(set=0,binding=2,std430) readonly buffer Level2 { float value[]; } L2;
layout(set=0,binding=3,std430) readonly buffer Level3 { float value[]; } L3;
layout(set=0,binding=4,std430) readonly buffer Level4 { float value[]; } L4;
layout(set=0,binding=5,std430) readonly buffer LevelMeta { int value[]; } lv;
layout(set=0,binding=6,std430) readonly buffer Params { float value[]; } lp;
layout(set=0,binding=7,std430) readonly buffer Meta { uint value[]; } meta;
layout(set=0,binding=8,std430) writeonly buffer Output { float value[]; } out_data;
const int kMaxTaps=160;
const float kMinSigma=0.4, kMinComet=0.05, kTruncate=3.5;
uint index() { return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x; }
vec3 ld3(int level,uint s) {
    uint j=3u*s;
    if(level==0)return vec3(L0.value[j],L0.value[j+1u],L0.value[j+2u]);
    if(level==1)return vec3(L1.value[j],L1.value[j+1u],L1.value[j+2u]);
    if(level==2)return vec3(L2.value[j],L2.value[j+1u],L2.value[j+2u]);
    if(level==3)return vec3(L3.value[j],L3.value[j+1u],L3.value[j+2u]);
    return vec3(L4.value[j],L4.value[j+1u],L4.value[j+2u]);
}
struct Level { int I0; int LH; int LW; };
struct Field { float var_t; float var_r; float L; };
struct Lod { int l0; float frac; float va; float vp; float q; float rho; bool enabled; };
Field field_at(float h) {
    float h0=lp.value[3], p=lp.value[4];
    float knee=h0>0.0?smoothstep(h0,min(h0+0.1,1.0),h):1.0;
    float u=h0>0.0?max(h-h0,0.0)/(1.0-h0):h;
    float g=knee*pow(max(u,0.0),p);
    float uc=h0>0.0?max(h-h0,0.0)/(1.0-h0):h;
    float gc=knee*uc;
    float sfc=lp.value[5]*g, sa=abs(lp.value[6])*g, L=lp.value[7]*gc;
    Field F;
    F.L=L;
    F.var_t=sfc*sfc+(lp.value[6]>0.0?sa*sa:0.0)+L*L/54.0;
    F.var_r=sfc*sfc+(lp.value[6]<0.0?sa*sa:0.0);
    return F;
}
float level_variance(int l) {
    float T=float(1<<l);
    return (T*T-1.0)/4.0+T*T/6.0;
}
Lod lod_for(float sigma,int lmax,bool force) {
    Lod d;
    d.enabled=sigma>=kMinSigma||force;
    d.q=clamp((sigma-kMinSigma)/(2.0-kMinSigma),0.0,1.0);
    d.rho=force?1.0:smoothstep(kMinSigma,4.0*kMinSigma,sigma);
    if(!d.enabled) { d.l0=0; d.frac=0.0; d.va=0.0; d.vp=0.0; d.rho=0.0; return d; }
    float lam=log2(sigma/4.0);
    if(lam<=0.0) { d.l0=0; d.frac=0.0; }
    else if(lam>=float(lmax)) { d.l0=lmax; d.frac=0.0; }
    else { d.l0=int(floor(lam)); d.frac=lam-float(d.l0); }
    float T0=float(1<<d.l0), T1=2.0*T0;
    d.va=(1.0-d.frac)*level_variance(d.l0)+(d.frac>0.0?d.frac*level_variance(d.l0+1):0.0);
    d.vp=d.va+0.25*d.q*d.q*((1.0-d.frac)*T0*T0+d.frac*T1*T1);
    return d;
}
vec3 level_sample(int level,Level L,float T,float X,float Y) {
    float u=(X+0.5)/T-0.5, v=(Y+0.5)/T-0.5;
    float uf=floor(u), vf=floor(v), fx=u-uf, fy=v-vf;
    int j0=clamp(int(uf),0,L.LW-1), j1=clamp(int(uf)+1,0,L.LW-1);
    int i0=clamp(int(vf)-L.I0,0,L.LH-1), i1=clamp(int(vf)+1-L.I0,0,L.LH-1);
    vec3 v00=ld3(level,uint(i0)*uint(L.LW)+uint(j0)), v01=ld3(level,uint(i0)*uint(L.LW)+uint(j1));
    vec3 v10=ld3(level,uint(i1)*uint(L.LW)+uint(j0)), v11=ld3(level,uint(i1)*uint(L.LW)+uint(j1));
    return (1.0-fy)*((1.0-fx)*v00+fx*v01)+fy*((1.0-fx)*v10+fx*v11);
}
float norm_cdf(float z) {
    float x=abs(z)*0.70710678118654752, t=1.0/(1.0+0.3275911*x);
    float y=1.0-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*exp(-x*x);
    return z>=0.0?0.5*(1.0+y):0.5*(1.0-y);
}
float norm_pdf(float z) { return exp(-0.5*z*z); }
float comet_weight(float s,float sigma,float L) {
    if(L<1e-3)return sigma>1e-3?norm_pdf(s/sigma):(abs(s)<0.5?1.0:0.0);
    if(sigma<1e-3)return (s>=0.0&&s<=L)?(1.0-s/L):0.0;
    float b=s/sigma, a=(s-L)/sigma;
    float dP=norm_cdf(b)-norm_cdf(a);
    float dp=(norm_pdf(b)-norm_pdf(a))*0.39894228040143268;
    return max(dP-(s*dP+sigma*dp)/L,0.0);
}
float comet_cdf(float s,float sigma,float L) {
    float a=(s-L)/sigma,b=s/sigma, Pa=norm_cdf(a),Pb=norm_cdf(b);
    float pa=norm_pdf(a)*0.39894228040143268,pb=norm_pdf(b)*0.39894228040143268;
    float I0=(b*Pb+pb)-(a*Pa+pa);
    float I1=0.5*(((b*b-1.0)*Pb+b*pb)-((a*a-1.0)*Pa+a*pa));
    return sigma*((1.0-s/L)*I0+(sigma/L)*I1);
}
float comet_cell(float s,float sigma,float L,float T) {
    sigma=max(sigma,0.02*T);
    return max(comet_cdf(s+0.5*T,sigma,L)-comet_cdf(s-0.5*T,sigma,L),0.0);
}
void main() {
    uint i=index(), H=meta.value[0], W=meta.value[1], row0=meta.value[2], mode=meta.value[3];
    int lmax=int(meta.value[4]);
    if(i>=H*W)return;
    uint y=i/W,x=i%W;
    float X=float(x),Y=float(y+row0),dx=X-lp.value[0],dy=Y-lp.value[1];
    float r=sqrt(dx*dx+dy*dy), h=r*lp.value[2];
    Field F=field_at(h);
    float La=abs(F.L);
    Lod lt=lod_for(sqrt(F.var_t),lmax,false);
    Lod lr=lod_for(sqrt(F.var_r+La*La/18.0),lmax,La>=kMinComet);
    Lod me=mode==0u?lt:lr;
    vec3 here=ld3(0,i);
    float jac=1.0;
    if(mode==1u&&lp.value[7]!=0.0&&r>1.0) {
        float Dm=field_at((r-0.5)*lp.value[2]).L/3.0;
        float Dp=field_at((r+0.5)*lp.value[2]).L/3.0;
        jac=(1.0-(Dp-Dm))*(1.0-(F.L/3.0)/r);
    }
    if(!me.enabled||me.rho<=0.0) {
        here*=jac;
        out_data.value[3u*i]=here.x; out_data.value[3u*i+1u]=here.y; out_data.value[3u*i+2u]=here.z;
        return;
    }
    float var=mode==0u?F.var_t-lr.rho*lr.vp:F.var_r-lt.rho*lt.vp;
    float sigma=sqrt(max(var/me.rho-me.va,0.0));
    vec2 er=r>1e-6?vec2(dx,dy)/r:vec2(1.0,0.0);
    vec2 e=mode==0u?vec2(-er.y,er.x):er, n=vec2(-e.y,e.x);
    float Ls=mode==1u?F.L:0.0, Lp=abs(Ls), sgn=Ls<0.0?-1.0:1.0;
    vec3 acc2=vec3(0.0);
    for(int k=0;k<2;++k) {
        int l=me.l0+k;
        float wl=k==0?1.0-me.frac:me.frac;
        if(wl<=0.0)continue;
        float T=float(1<<l);
        Level L=Level(lv.value[3*l],lv.value[3*l+1],lv.value[3*l+2]);
        float smin=-kTruncate*sigma-(sgn<0.0?Lp:0.0);
        float smax=kTruncate*sigma+(sgn>0.0?Lp:0.0);
        float step=Lp>0.0?min(T,max(Lp/6.0,0.125)):T;
        int k0=int(floor(smin/step)), k1=int(ceil(smax/step));
        if(k1-k0+1>kMaxTaps) { step=(smax-smin)/float(kMaxTaps-1); k0=int(floor(smin/step)); k1=int(ceil(smax/step)); }
        vec3 acc=vec3(0.0);
        float wsum=0.0, sigc=sqrt(max(sigma*sigma-step*step/12.0,0.0));
        for(int t=k0;t<=k1;++t) {
            float s=float(t)*step;
            float w=Lp>0.0?comet_cell(sgn*s,sigc,Lp,step):comet_weight(s,sigma,0.0);
            if(w<=0.0)continue;
            float qx=X-s*e.x, qy=Y-s*e.y, o=0.5*T*me.q;
            acc+=(0.5*w)*(level_sample(l,L,T,qx+o*n.x,qy+o*n.y)+level_sample(l,L,T,qx-o*n.x,qy-o*n.y));
            wsum+=w;
        }
        acc2+=wl*(wsum>0.0?acc/wsum:here);
    }
    acc2=mix(here,acc2,me.rho)*jac;
    out_data.value[3u*i]=acc2.x; out_data.value[3u*i+1u]=acc2.y; out_data.value[3u*i+2u]=acc2.z;
}
