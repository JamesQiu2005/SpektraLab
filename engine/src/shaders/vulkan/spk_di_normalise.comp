#version 450

// DI and the shipped print LUT share these per-channel density axes.
// One thread per scalar, not per pixel, matching util.metal's count contract.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Density { float value[]; } density;
layout(set = 0, binding = 1, std430) readonly buffer Lower { float value[]; } lower;
layout(set = 0, binding = 2, std430) readonly buffer InverseSpan { float value[]; } inverse_span;
layout(set = 0, binding = 3, std430) readonly buffer Count { uint value[]; } count_data;
layout(set = 0, binding = 4, std430) writeonly buffer Output { float value[]; } output_data;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count_data.value[0]) return;
    uint channel = i % 3u;
    precise float value = (density.value[i] - lower.value[channel]) * inverse_span.value[channel];
    // Metal precise clamp uses fmin/fmax, where one NaN operand gives the
    // other operand. Explicit branches avoid GLSL FClamp's undefined choice.
    if (isnan(value) || value < 0.0) value = 0.0;
    else if (value > 1.0) value = 1.0;
    output_data.value[i] = value;
}
