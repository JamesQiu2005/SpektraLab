#version 450
#extension GL_GOOGLE_include_directive : require

// RFC-024's analysis, from contrast_mask.metal: one thread per grid cell, the
// mean of `x` over the cell's pixels. The cells partition the frame
// (`[cx*W/gw, (cx+1)*W/gw)`), so every pixel is counted exactly once whatever
// the tier's size, and each cell sums its pixels in Metal's row order.
layout(local_size_x = 256) in;
#include "spk_mask.glsl"
layout(set = 0, binding = 5, std430) readonly buffer Meta { uint value[]; } meta;
layout(set = 0, binding = 6, std430) writeonly buffer Output { float value[]; } output_data;

void main() {
    uint W = meta.value[0], H = meta.value[1], gw = meta.value[2], gh = meta.value[3], nl = meta.value[4];
    uint cell = spk_global_index();
    if (cell >= gw * gh) return;
    uint cy = cell / gw, cx = cell % gw;
    uint x0 = (cx * W) / gw, x1 = max(((cx + 1u) * W) / gw, x0 + 1u);
    uint y0 = (cy * H) / gh, y1 = max(((cy + 1u) * H) / gh, y0 + 1u);
    x1 = min(x1, W); y1 = min(y1, H);
    float acc = 0.0;
    for (uint y = y0; y < y1; ++y)
        for (uint x = x0; x < x1; ++x)
            acc += mask_x(mask_image_exposure(y * W + x, nl));
    output_data.value[cell] = acc / float((x1 - x0) * (y1 - y0));
}
