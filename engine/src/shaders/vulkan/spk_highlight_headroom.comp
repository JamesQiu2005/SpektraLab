#version 450

// Metal's spk_highlight_headroom (nodes.metal), line for line: `node_headroom` gives a
// film with no anti-halation layer (CineStill 800T) the headroom a digital frame clipped
// off its highlights. Per pixel, from its brightest channel m, the product of two
// smoothsteps in stops -- near the frame's maximum (the clip) and over a floor above
// mid-grey -- and the pixel scaled by 2^(headroom * s), all three channels alike.
// p = {1/clip, clip_from, clip_inv_span, headroom, 1/mid-grey, floor_from, floor_inv_span}.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } input_data;
layout(set = 0, binding = 1, std430) readonly buffer Parameters { float value[]; } p;
layout(set = 0, binding = 2, std430) readonly buffer Count { uint value[]; } count_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float value[]; } output_data;

// vulkan_gpu.cpp folds a dispatch past maxComputeWorkGroupCount[0] (65535 on
// lavapipe and Intel) into rows of workgroups; this is the 1D index it means.
uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

float spk_smoothstep01(float t) {
    t = clamp(t, 0.0, 1.0);
    precise float s = t * t * (3.0 - 2.0 * t);
    return s;
}

void main() {
    uint i = spk_global_index();
    if (i >= count_data.value[0]) return;
    vec3 v = vec3(input_data.value[3 * i], input_data.value[3 * i + 1], input_data.value[3 * i + 2]);
    float m = max(v.x, max(v.y, v.z));
    float g = 1.0;
    if (m > 0.0) {
        float lm = log2(m);
        precise float near_t = (lm + log2(p.value[0]) - p.value[1]) * p.value[2];
        precise float floor_t = (lm + log2(p.value[4]) - p.value[5]) * p.value[6];
        float near_clip = spk_smoothstep01(near_t);
        float over_floor = spk_smoothstep01(floor_t);
        precise float e = p.value[3] * near_clip * over_floor;
        g = exp2(e);
    }
    precise vec3 o = v * g;
    output_data.value[3 * i] = o.x;
    output_data.value[3 * i + 1] = o.y;
    output_data.value[3 * i + 2] = o.z;
}
