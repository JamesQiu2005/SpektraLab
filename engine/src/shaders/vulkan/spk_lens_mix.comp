#version 450
#extension GL_GOOGLE_include_directive : require
// lens.metal spk_lens_mix: out = a * raw + b * (fine + up(grid A) + up(grid B)).
// meta: {H, W, row0, has_fine, fa, I0a, LHa, LWa, fb, I0b, LHb, LWb}; ab: a[3], b[3].
#include "spk_lens.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Raw { float raw[]; };
layout(std430, binding = 1) readonly buffer Fine { float fine[]; };
layout(std430, binding = 2) readonly buffer Ga { float ga[]; };
layout(std430, binding = 3) readonly buffer Gb { float gb[]; };
layout(std430, binding = 4) readonly buffer Ab { float ab[]; };
layout(std430, binding = 5) readonly buffer Meta { uint meta[]; };
layout(std430, binding = 6) writeonly buffer Out { float dst[]; };

SPK_GRID_UP_FN(grid_up_a, ga)
SPK_GRID_UP_FN(grid_up_b, gb)

void main() {
    uint i = spk_global_index();
    uint H = meta[0], W = meta[1], row0 = meta[2], has_fine = meta[3];
    if (i >= H * W) return;
    uint y = i / W, x = i % W;
    float X = float(x), Y = float(y + row0);
    vec3 m = vec3(0.0);
    if (has_fine != 0u) m += SPK_LD3(fine, i);
    if (meta[4] != 0u) m += grid_up_a(int(meta[6]), int(meta[7]), int(meta[5]), meta[4], X, Y);
    if (meta[8] != 0u) m += grid_up_b(int(meta[10]), int(meta[11]), int(meta[9]), meta[8], X, Y);
    vec3 r = SPK_LD3(raw, i);
    vec3 o = vec3(ab[0], ab[1], ab[2]) * r + vec3(ab[3], ab[4], ab[5]) * m;
    SPK_ST3(dst, i, o);
}
