#version 450
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer Raw { float value[]; } raw_data;
layout(set=0,binding=1,std430) readonly buffer Fine { float value[]; } fine_data;
layout(set=0,binding=2,std430) readonly buffer GridA { float value[]; } grid_a;
layout(set=0,binding=3,std430) readonly buffer GridB { float value[]; } grid_b;
layout(set=0,binding=4,std430) readonly buffer AB { float value[]; } ab;
layout(set=0,binding=5,std430) readonly buffer Meta { uint value[]; } meta;
layout(set=0,binding=6,std430) writeonly buffer Output { float value[]; } out_data;
uint index() { return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x; }
vec3 grid_ld3(bool second, uint s) {
    uint j=3u*s;
    if(second)return vec3(grid_b.value[j],grid_b.value[j+1u],grid_b.value[j+2u]);
    return vec3(grid_a.value[j],grid_a.value[j+1u],grid_a.value[j+2u]);
}
vec3 grid_up(bool second, int LH, int LW, int I0, uint f, float x, float Y) {
    float ff=float(f), c=0.5*float(f-1u), u=(x-c)/ff, v=(Y-c)/ff;
    float uf=floor(u), vf=floor(v), fx=u-uf, fy=v-vf;
    int j0=clamp(int(uf),0,LW-1), j1=clamp(int(uf)+1,0,LW-1);
    int i0=clamp(int(vf)-I0,0,LH-1), i1=clamp(int(vf)+1-I0,0,LH-1);
    vec3 v00=grid_ld3(second,uint(i0)*uint(LW)+uint(j0)), v01=grid_ld3(second,uint(i0)*uint(LW)+uint(j1));
    vec3 v10=grid_ld3(second,uint(i1)*uint(LW)+uint(j0)), v11=grid_ld3(second,uint(i1)*uint(LW)+uint(j1));
    return (1.0-fy)*((1.0-fx)*v00+fx*v01)+fy*((1.0-fx)*v10+fx*v11);
}
void main() {
    uint i=index(), H=meta.value[0], W=meta.value[1], row0=meta.value[2], has_fine=meta.value[3];
    if(i>=H*W)return;
    uint y=i/W, x=i%W;
    float X=float(x), Y=float(y+row0);
    vec3 m=vec3(0.0);
    if(has_fine!=0u)m+=vec3(fine_data.value[3u*i],fine_data.value[3u*i+1u],fine_data.value[3u*i+2u]);
    if(meta.value[4]!=0u)m+=grid_up(false,int(meta.value[6]),int(meta.value[7]),int(meta.value[5]),meta.value[4],X,Y);
    if(meta.value[8]!=0u)m+=grid_up(true,int(meta.value[10]),int(meta.value[11]),int(meta.value[9]),meta.value[8],X,Y);
    vec3 r=vec3(raw_data.value[3u*i],raw_data.value[3u*i+1u],raw_data.value[3u*i+2u]);
    vec3 o=vec3(ab.value[0],ab.value[1],ab.value[2])*r+vec3(ab.value[3],ab.value[4],ab.value[5])*m;
    out_data.value[3u*i]=o.x; out_data.value[3u*i+1u]=o.y; out_data.value[3u*i+2u]=o.z;
}
