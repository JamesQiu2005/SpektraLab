#version 450
// Test-only replacement probes. Never ship these SPIR-V files.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } src;
layout(set = 0, binding = 1, std430) writeonly buffer Output { float value[]; } dst;
void main() {
    uint i = gl_GlobalInvocationID.x;
#if PAIR
    dst.value[2 * i] = 0.0;
    dst.value[2 * i + 1] = 0.0;
#else
    // Mixed nonzero and zero residuals also exercise the fallback, not only
    // the all-zero behaviour observed with an unfused implementation.
    dst.value[i] = MIXED != 0 && (i & 1u) == 0u ? 0.25 : 0.0;
#endif
}
