set(SPEKTRALAB_LENS_PREFIX "${SPEKTRALAB_DEPS_DIR}/lens-codecs/install" CACHE PATH "Pinned static Lensfun and GLib installation")
if(NOT EXISTS "${SPEKTRALAB_LENS_PREFIX}/include/lensfun/lensfun.h")
    message(FATAL_ERROR "Lens correction dependencies missing: build the pinned engine/setup-lens-codecs.py installation and set SPEKTRALAB_LENS_PREFIX")
endif()
add_library(spk_lens INTERFACE)
target_include_directories(spk_lens INTERFACE "${SPEKTRALAB_LENS_PREFIX}/include"
    "${SPEKTRALAB_LENS_PREFIX}/include/glib-2.0" "${SPEKTRALAB_LENS_PREFIX}/lib/glib-2.0/include")
target_compile_definitions(spk_lens INTERFACE CONF_LENSFUN_STATIC GLIB_STATIC_COMPILATION G_INTL_STATIC_COMPILATION PCRE2_STATIC)
foreach(component lensfun glib-2.0 intl pcre2-8)
    if(MSVC)
        set(archive "${SPEKTRALAB_LENS_PREFIX}/lib/${component}.lib")
    else()
        set(archive "${SPEKTRALAB_LENS_PREFIX}/lib/lib${component}.a")
    endif()
    if(NOT EXISTS "${archive}")
        message(FATAL_ERROR "Missing pinned lens dependency: ${archive}")
    endif()
    target_link_libraries(spk_lens INTERFACE "${archive}")
endforeach()
if(WIN32)
    target_link_libraries(spk_lens INTERFACE ws2_32 winmm ole32 shlwapi uuid)
endif()
if(NOT MSVC)
    target_link_libraries(spk_lens INTERFACE atomic m)
endif()
# Keep lens calibration data beside the same resources as the material model.
# It is never loaded from an uncontrolled per-user/global Lensfun installation.
file(COPY "${SPEKTRALAB_LENS_PREFIX}/share/lensfun/version_2" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/../resources/lensfun")
if(EXISTS "${SPEKTRALAB_LENS_PREFIX}/share/spektralab-lens")
    file(COPY "${SPEKTRALAB_LENS_PREFIX}/share/spektralab-lens/" DESTINATION "${CMAKE_CURRENT_BINARY_DIR}/third-party/lens")
endif()
