set(SPEKTRALAB_INPUT_CODEC_PREFIX "${SPEKTRALAB_DEPS_DIR}/input-codecs/install" CACHE PATH "Static input codec installation")
if(NOT EXISTS "${SPEKTRALAB_INPUT_CODEC_PREFIX}/include/lcms2.h")
    message(FATAL_ERROR "Extra input codecs missing. Run engine/setup-input-codecs.py and set SPEKTRALAB_INPUT_CODEC_PREFIX.")
endif()
list(PREPEND CMAKE_PREFIX_PATH "${SPEKTRALAB_INPUT_CODEC_PREFIX}")
if(CMAKE_CROSSCOMPILING)
    # Root-only package searches otherwise re-root this staged installation
    # under the compiler sysroot, hiding OpenEXR and its Imath dependency.
    list(PREPEND CMAKE_FIND_ROOT_PATH "${SPEKTRALAB_INPUT_CODEC_PREFIX}")
    list(REMOVE_DUPLICATES CMAKE_FIND_ROOT_PATH)
endif()
find_package(OpenEXR 3.5.2 EXACT CONFIG REQUIRED)
find_package(libheif 1.23.6 EXACT CONFIG REQUIRED)
add_library(spk_input_lcms STATIC IMPORTED)
if(MSVC)
    set(lcms_library "${SPEKTRALAB_INPUT_CODEC_PREFIX}/lib/lcms2.lib")
else()
    set(lcms_library "${SPEKTRALAB_INPUT_CODEC_PREFIX}/lib/liblcms2.a")
endif()
set_target_properties(spk_input_lcms PROPERTIES IMPORTED_LOCATION "${lcms_library}"
    INTERFACE_INCLUDE_DIRECTORIES "${SPEKTRALAB_INPUT_CODEC_PREFIX}/include")
add_library(spk_input_codecs INTERFACE)
target_link_libraries(spk_input_codecs INTERFACE OpenEXR::OpenEXR heif spk_input_lcms)
file(GLOB input_notices "${SPEKTRALAB_INPUT_CODEC_PREFIX}/share/spektralab-input-codecs/licenses/*")
if(NOT input_notices)
    message(FATAL_ERROR "Input codec notices missing: rerun engine/setup-input-codecs.py install step")
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/third-party/input-codecs")
foreach(notice IN LISTS input_notices)
    get_filename_component(name "${notice}" NAME)
    configure_file("${notice}" "third-party/input-codecs/${name}" COPYONLY)
endforeach()
