keywords:
  - "film emulation"
  - "spectral imaging"
  - "color science"
  - "RA-4 print simulation"
  - "Metal"
  - "macOS"
  - "GPU rendering"

references:
  - type: "software"
    title: "spektrafilm: spectral simulation of analog photography"
    abstract: |
      The spectral film and print simulation SpektraLab renders. Source of the
      28 film and paper profiles, the characteristic curves, the DIR-coupler
      and halation models, and the RA-4 print and scan chain.
    authors:
