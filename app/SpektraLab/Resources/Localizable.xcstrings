    "No picture is moved, copied or deleted: the catalog reads each one where it is. Your edits and developed pictures stay as they are." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真は移動、コピー、削除されません。カタログはそれぞれを元の場所で読み込みます。編集と現像した写真はそのままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会移动、拷贝或删除任何照片：目录在原处读取每一张。你的编辑和冲洗好的照片保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
