    },
    "They come back when a frame needs them. Originals in your folders and catalogs are never moved or deleted. This Mac develops up to %@ MP." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真に必要になると、また作られます。フォルダやカタログの元ファイルは移動・削除しません。このMacで現像できるのは最大%@ MPです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片需要时会重新生成。你的文件夹和目录里的原件绝不会被移动或删除。这台 Mac 最大可冲洗 %@ MP。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
