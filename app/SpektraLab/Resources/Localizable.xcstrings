    "Your library in numbers: how many frames, from where, their sizes and the cameras they came from, and the storage they take." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリの数値：写真の枚数、取得元、サイズ、撮影したカメラ、使用しているストレージ。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图库的统计数字：照片数量、来源、尺寸、拍摄它们的相机，以及占用的储存空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖庫的統計數字：照片數量、來源、尺寸、拍攝它們的相機，以及佔用的儲存空間。"
          }
        }
      }
    },
    "Your library is a SpektraLab catalog now. The pictures are read where they are; nothing is moved or copied." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
