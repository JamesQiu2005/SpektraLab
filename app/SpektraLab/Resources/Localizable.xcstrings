    },
    "%@ is a black-and-white film: it prints on a black-and-white paper. The colour papers wait for a colour film." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は白黒フィルムです。白黒印画紙を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 为黑白胶片，需用黑白相纸。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 為黑白底片，請使用黑白相紙。"
          }
        }
      }
    },
    "%@ is a slide." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はリバーサルフィルムです。"
