        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是正片。"
          }
        }
      }
    },
    "%@ is a slide: it is scanned, not printed. The paper waits for a negative." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はリバーサルフィルムです。焼き付けずスキャンします。"
