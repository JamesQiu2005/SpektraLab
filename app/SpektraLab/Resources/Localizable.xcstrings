    "SpektraLab changes at once. What macOS shows of its own, such as a Finder panel, follows the next time the app is opened." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLabの表示はすぐに切り替わります。Finderのパネルなど、macOSが表示する部分は、次にAppを開いたときから切り替わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLab 会立即切换。macOS 自己显示的部分，例如访达的面板，要到下次打开 App 时才会跟着改变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLab 會立即切換。macOS 自己顯示的部分，例如 Finder 的面板，要到下次開啟 App 時才會跟著改變。"
          }
        }
      }
    },
    "SpektraLab engine" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLabエンジン"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLab 引擎"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLab 引擎"
          }
        }
      }
    },
    "SpektraLab for the Mac is free and open source. Thank you to everyone who supports its development." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 版 SpektraLab は無料のオープンソースソフトウェアです。開発を支えてくださる皆さまに感謝します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLab Mac 版免费并开源。感谢每一位支持它继续开发的朋友。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLab Mac 版免費且開源。感謝每一位支持它持續開發的朋友。"
          }
        }
      }
    },
    "SpektraLab keeps its own copy" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App内にコピーを保存"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 内另存一份"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 內另存一份"
          }
        }
      }
    },
    "SpektraLab may no longer read it. Reconnect to allow it again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス権がありません。「再接続」してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无访问权限，请“重新连接”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無取用權限，請「重新連接」。"
          }
        }
      }
    },
    "SpektraLab never changes or deletes anything in your folders or in a Capture One catalog. Edits live in the app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLabは、フォルダやCapture Oneのカタログの中身を変更したり削除したりしません。編集内容はApp内に保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLab 绝不会改动或删除你的文件夹或 Capture One 目录里的任何东西。编辑保存在 App 里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SpektraLab 絕不會改動或刪除你的檔案夾或 Capture One 目錄裡的任何東西。編輯保存在 App 裡。"
          }
        }
      }
    },
    "SpektraLab's server could not be reached from here (%@). Export Log Zip, and send it by hand." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここからSpektraLabのサーバに接続できませんでした（%@）。「動作記録をZIPで書き出す」で書き出して、手動で送ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从这里连不上 SpektraLab 的服务器（%@）。请用“导出日志压缩包”，再自行发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從這裡連不上 SpektraLab 的伺服器（%@）。請用「輸出日誌壓縮檔」，再自行傳送。"
          }
        }
      }
    },
