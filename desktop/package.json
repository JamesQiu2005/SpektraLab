{
  "name": "spektralab",
  "productName": "SpektraLab",
  "version": "1.3.1",
  "description": "SpektraLab — film and print emulation for Linux and Windows",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "SpektraLab contributors",
    "email": "hq2144@nyu.edu"
  },
  "homepage": "https://github.com/spektrafilm",
  "private": true,
  "scripts": {
    "dev:web": "vite",
    "dev": "tauri dev",
    "dev:mock": "SPEKTRALAB_MOCK_HOST=1 tauri dev",
    "build:web": "vite build",
    "predev:web": "node scripts/copy-assets.mjs",
    "prebuild:web": "node scripts/copy-assets.mjs",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "gen:strings": "node scripts/extract-strings.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:assets": "node scripts/copy-assets.mjs",
    "package:linux": "node scripts/package.mjs linux",
    "package:win": "node scripts/package.mjs win"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  },
  "type": "module"
}